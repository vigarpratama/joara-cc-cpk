# Salin jadi .env lalu ganti nilainya
DB_PASSWORD=joara123
JWT_SECRET=ganti-dengan-string-acak-panjang
INTERNAL_KEY=ganti-dengan-string-acak-lain
# Kunci yang sama harus dipakai app Flutter: --dart-define=APP_KEY=...
APP_KEY=ganti-dengan-string-acak-ketiga
# true = otomatis buat akun demo member@demo.com & kurir@demo.com (password demo123)
SEED_DEMO=true

# mock = QRIS tiruan buat demo | midtrans = QRIS asli (dana masuk ke rekening merchant kamu)
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
# sandbox (tes): https://api.sandbox.midtrans.com | production (uang asli): https://api.midtrans.com
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
